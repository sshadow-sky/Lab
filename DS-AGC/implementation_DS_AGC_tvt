def cross_subject(
    target_set,
    validation_set,
    source_set_labeled,
    source_set_unlabeled,
    subject_id,
    validation_id,
    parameter,
    net_params,
):
    """Run one strict N-2 + 1 + 1 fold.

    The target subject is used without labels during adaptation.  The
    validation subject is excluded from optimization and selects the best
    checkpoint.  Target labels are read only after that checkpoint is loaded.
    """
    setup_seed(2024)

    def _tensor_dataset(split):
        feature = np.ascontiguousarray(split["feature"], dtype=np.float32)
        label = np.ascontiguousarray(split["label"], dtype=np.float32)
        return Data.TensorDataset(
            torch.from_numpy(feature),
            torch.from_numpy(label),
        )

    target_dataset = _tensor_dataset(target_set)
    validation_dataset = _tensor_dataset(validation_set)
    source_labeled_dataset = _tensor_dataset(source_set_labeled)
    source_unlabeled_dataset = _tensor_dataset(source_set_unlabeled)

    batch_size = int(parameter["batch_size"])

    source_labeled_loader = Data.DataLoader(
        dataset=source_labeled_dataset,
        batch_size=batch_size,
        shuffle=True,
        drop_last=True,
    )
    source_unlabeled_loader = Data.DataLoader(
        dataset=source_unlabeled_dataset,
        batch_size=batch_size,
        shuffle=True,
        drop_last=True,
    )
    # This loader is iterated during adaptation. Its labels are present only
    # because TensorDataset requires a pair; train_GCN_contrast deliberately
    # ignores them inside the training loop.
    target_loader = Data.DataLoader(
        dataset=target_dataset,
        batch_size=batch_size,
        shuffle=True,
        drop_last=True,
    )
    validation_loader = Data.DataLoader(
        dataset=validation_dataset,
        batch_size=batch_size,
        shuffle=False,
        drop_last=False,
    )

    if len(source_labeled_loader) == 0:
        raise RuntimeError(
            "No complete labeled-source batch is available; reduce batch_size."
        )
    if len(source_unlabeled_loader) == 0:
        raise RuntimeError(
            "No complete unlabeled-source batch is available; reduce "
            "batch_size or num_of_U."
        )
    if len(target_loader) == 0:
        raise RuntimeError(
            "No complete target batch is available; reduce batch_size."
        )

    return train_GCN_contrast(
        subject_id,
        validation_id,
        parameter,
        net_params,
        source_labeled_loader,
        source_unlabeled_loader,
        target_loader,
        validation_loader,
    )

def _configure_dataset(dataset_name, parameter):
    """Apply dataset-dependent class/channel/subject settings."""
    key = dataset_name.strip().lower().replace("-", "_")
    configs = {
        "seed": {"subjects": 15, "classes": 3, "channels": 62, "sessions": 3, "display": "SEED"},
        "seediv": {"subjects": 15, "classes": 4, "channels": 62, "sessions": 3, "display": "SEEDIV"},
        "seed_iv": {"subjects": 15, "classes": 4, "channels": 62, "sessions": 3, "display": "SEEDIV"},
        "seedv": {"subjects": 16, "classes": 5, "channels": 62, "sessions": 3, "display": "SEEDV"},
        "seed_v": {"subjects": 16, "classes": 5, "channels": 62, "sessions": 3, "display": "SEEDV"},
        "deap_a": {"subjects": 32, "classes": 2, "channels": 32, "sessions": 1, "display": "DEAP_A"},
        "deap_v": {"subjects": 32, "classes": 2, "channels": 32, "sessions": 1, "display": "DEAP_V"},
    }
    if key not in configs:
        raise ValueError(
            "Unsupported DATASET={!r}. Choose from seed, seediv, seedv, deap_a, deap_v."
            .format(dataset_name)
        )
    cfg = configs[key]
    parameter["category_number"] = cfg["classes"]
    parameter["num_of_vertices"] = cfg["channels"]
    parameter["num_of_features"] = 5
    return key, cfg


def main(
    parameter,
    net_params,
    dataset_name=DATASET,
    session_id=SESSION_ID,
    protocol=PROTOCOL,
):
    setup_seed(2024)
    dataset_key, cfg = _configure_dataset(dataset_name, net_params)
    if parameter is not net_params:
        _configure_dataset(dataset_name, parameter)
    if not 0 <= session_id < cfg['sessions']:
        raise ValueError(
            'Session {} is invalid for {} ({} session(s)).'.format(
                session_id, cfg['display'], cfg['sessions']
            )
        )

    protocol = str(parameter.get('protocol', protocol)).strip().lower()
    if protocol not in {'single_tvt', 'strict_loso'}:
        raise ValueError(
            "Unsupported protocol={!r}; choose 'single_tvt' or 'strict_loso'."
            .format(protocol)
        )
    parameter['protocol'] = protocol

    sub_num = cfg['subjects']
    print('Model name: DS-AGC. Dataset name: {}'.format(cfg['display']))
    print(
        'session={}, subjects={}, classes={}, channels={}, bands={}'.format(
            session_id,
            sub_num,
            cfg['classes'],
            cfg['channels'],
            net_params['num_of_features'],
        )
    )

    global Dataset_name
    Dataset_name = cfg['display']

    if protocol == 'single_tvt':
        print(
            'Protocol: fixed single train + validation + test; target/test '
            'features are unlabeled during adaptation; validation alone '
            'selects the checkpoint.'
        )
        (
            target_set,
            validation_set,
            source_set_labeled,
            source_set_unlabeled,
            labeled_ids,
            unlabeled_ids,
            train_ids,
            validation_ids,
            test_ids,
        ) = get_single_tvt_dataset(dataset_key, session_id, parameter)

        print(
            'single TVT split: train_ids={}, validation_ids={}, test_ids={}'
            .format(train_ids, validation_ids, test_ids)
        )
        print(
            'DS-AGC source split inside train: labeled_ids={}, unlabeled_ids={}'
            .format(labeled_ids, unlabeled_ids)
        )
        print(
            '1-based split: train={}, validation={}, test={}'.format(
                [idx + 1 for idx in train_ids],
                [idx + 1 for idx in validation_ids],
                [idx + 1 for idx in test_ids],
            )
        )

        parameter['fold_tag'] = 'fixed_split'
        val_curve, test_acc, best_val_acc, best_epoch = cross_subject(
            target_set,
            validation_set,
            source_set_labeled,
            source_set_unlabeled,
            'fixed_test',
            'fixed_val',
            parameter,
            net_params,
        )

        test_acc_mat = np.asarray([test_acc], dtype=np.float64)
        best_validation_acc_mat = np.asarray([best_val_acc], dtype=np.float64)
        best_epoch_mat = np.asarray([best_epoch], dtype=np.int64)
        validation_acc_curve = val_curve.reshape(1, -1)

        result_list = {
            'test_acc_mat': test_acc_mat,
            'best_validation_acc_mat': best_validation_acc_mat,
            'best_epoch_mat': best_epoch_mat,
            'validation_acc_curve': validation_acc_curve,
            'protocol': 'single_tvt_fixed_split',
            'train_ids': train_ids,
            'validation_ids': validation_ids,
            'test_ids': test_ids,
            'labeled_ids': labeled_ids,
            'unlabeled_ids': unlabeled_ids,
            'num_of_U': parameter['num_of_U'],
        }
        result_path = os.path.join(
            RESULT_DIR,
            'single_tvt_{}_session{}_batch{}_{}epoch_{}U.npy'.format(
                Dataset_name,
                session_id,
                parameter['batch_size'],
                parameter['threshold'],
                parameter['num_of_U'],
            ),
        )
        np.save(result_path, result_list)
        print('Final single-TVT test accuracy: {:.4f}'.format(test_acc))
        print('Best validation accuracy: {:.4f}'.format(best_val_acc))
        print('Best epoch:', best_epoch)
        print('Saved result to:', result_path)
        return test_acc_mat.tolist(), result_path

    # Original strict N-2 + 1 + 1 LOSO branch.
    offset = parameter.get('validation_offset', 1) % sub_num
    if offset == 0:
        raise ValueError('validation_offset cannot be a multiple of subject count.')
    print(
        'Protocol: strict N-2 + 1 + 1; target features are unlabeled during '
        'adaptation; validation alone selects the checkpoint.'
    )

    test_acc_mat = np.zeros(sub_num)
    best_validation_acc_mat = np.zeros(sub_num)
    best_epoch_mat = np.zeros(sub_num, dtype=np.int64)
    validation_acc_curve = np.full(
        (sub_num, parameter['epochs']), np.nan
    )

    for test_id in range(sub_num):
        validation_id = (test_id + offset) % sub_num
        (
            target_set,
            validation_set,
            source_set_labeled,
            source_set_unlabeled,
            labeled_ids,
            unlabeled_ids,
        ) = get_strict_dataset(
            dataset_key,
            test_id,
            validation_id,
            session_id,
            parameter,
        )
        print(
            'fold {}/{}: labeled_ids={}, unlabeled_ids={}, validation={}, test={}'.format(
                test_id + 1,
                sub_num,
                labeled_ids,
                unlabeled_ids,
                validation_id,
                test_id,
            )
        )
        parameter['fold_tag'] = 'test{:02d}_val{:02d}'.format(
            test_id, validation_id
        )
        val_curve, test_acc, best_val_acc, best_epoch = cross_subject(
            target_set,
            validation_set,
            source_set_labeled,
            source_set_unlabeled,
            test_id,
            validation_id,
            parameter,
            net_params,
        )
        validation_acc_curve[test_id, :] = val_curve
        test_acc_mat[test_id] = test_acc
        best_validation_acc_mat[test_id] = best_val_acc
        best_epoch_mat[test_id] = best_epoch

    result_list = {
        'test_acc_mat': test_acc_mat,
        'best_validation_acc_mat': best_validation_acc_mat,
        'best_epoch_mat': best_epoch_mat,
        'validation_acc_curve': validation_acc_curve,
        'protocol': 'strict_N_minus_2_plus_1_plus_1',
    }
    result_path = os.path.join(
        RESULT_DIR,
        'strict_loso_{}_session{}_batch{}_{}epoch_{}U.npy'.format(
            Dataset_name,
            session_id,
            parameter['batch_size'],
            parameter['threshold'],
            parameter['num_of_U'],
        ),
    )
    np.save(result_path, result_list)
    print('Final test accuracies:', test_acc_mat.tolist())
    print(
        'Final test accuracy: {:.4f} ± {:.4f}'.format(
            test_acc_mat.mean(), test_acc_mat.std()
        )
    )
    print('Saved result to:', result_path)
    return test_acc_mat.tolist(), result_path



