def get_dataset(test_id, session, parameter):

    data, _, labels, _, _ = read_seed_feature(
        SEED_PATH,
        "de_lds"
    )

    min_max_scaler = preprocessing.MinMaxScaler(
        feature_range=(-1, 1)
    )

    feature_list_source_labeled = []
    label_list_source_labeled = []

    feature_list_source_unlabeled = []
    label_list_source_unlabeled = []

    feature_list_target = []
    label_list_target = []

    u_list = []

    for u in range(parameter["num_of_U"]):

        idx = (test_id + u + 1) % 15

        u_list.append(idx)

    for subject in range(15):

        feature = []
        label = []

        for trial_id in range(
                len(data[session][subject])):

            trial_feature = np.array(
                data[session][subject][trial_id]
            )

            trial_label = labels[
                session][subject][trial_id]

            feature.append(trial_feature)

            label.extend(
                [trial_label] *
                len(trial_feature)
            )

        feature = np.vstack(feature)

        label = np.array(label)

        feature = min_max_scaler.fit_transform(
            feature.reshape(
                feature.shape[0],
                -1
            )
        )

        feature = feature.reshape(
            feature.shape[0],
            62,
            5
        ).astype(np.float32)

        one_hot = to_onehot(label, 3)

        if subject == test_id:

            feature_list_target.append(feature)
            label_list_target.append(one_hot)

        else:

            if parameter["semi"] == 1 and subject in u_list:

                feature_list_source_unlabeled.append(
                    feature
                )

                label_list_source_unlabeled.append(
                    one_hot
                )

            else:

                feature_list_source_labeled.append(
                    feature
                )

                label_list_source_labeled.append(
                    one_hot
                )

    target_set = {
        "feature": np.vstack(feature_list_target),
        "label": np.vstack(label_list_target)
    }

    source_set_labeled = {
        "feature": np.vstack(
            feature_list_source_labeled),
        "label": np.vstack(
            label_list_source_labeled)
    }

    source_set_unlabeled = {
        "feature": np.vstack(
            feature_list_source_unlabeled),
        "label": np.vstack(
            label_list_source_unlabeled)
    }

    return (
        target_set,
        source_set_labeled,
        source_set_unlabeled
    )

